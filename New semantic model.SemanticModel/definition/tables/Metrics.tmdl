	measure 'Top 3 Accounts Insufficient Inventory Amount' = ```
			
			    VAR Top3 =
			        TOPN(3, ALL(dim_restaurant[customer_number]),
			            [Insufficient Inventory Lines], DESC,
			            [Insufficient Inventory Amount], DESC)
			    RETURN CALCULATE([Insufficient Inventory Amount], KEEPFILTERS(Top3))
			```
		lineageTag: 3f8322fa-1de9-4761-8050-0800ae224b56

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 3 Restaurants Insufficient Inventory Amount' = ```
			
			    VAR Top3 =
			        TOPN(3,
			            FILTER(ALL(dim_restaurant[restaurant_location_id]), dim_restaurant[restaurant_location_id] <> "99999"),
			            [Insufficient Inventory Lines], DESC,
			            [Insufficient Inventory Amount], DESC)
			    RETURN CALCULATE([Insufficient Inventory Amount], KEEPFILTERS(Top3))
			```
