	measure 'MA Base' = ```
			
			    VAR LastM = DATE(YEAR([Data End Date]), MONTH([Data End Date]), 1)
			    RETURN CALCULATE(
			        AVERAGEX(
			            FILTER(ALL(dim_date[month_start_date]),
			                dim_date[month_start_date] > EDATE(LastM, -3) && dim_date[month_start_date] <= LastM),
			            [Order Amount]),
			        REMOVEFILTERS(dim_date))
			```
		lineageTag: e39d8020-1c51-4fc8-afb8-11c587e7bc07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Moving Avg' = ```
			
			    VAR LastM = DATE(YEAR([Data End Date]), MONTH([Data End Date]), 1)
			    VAR Ahead = DATEDIFF(LastM, MAX(dim_date[month_start_date]), MONTH)
			    RETURN IF(Ahead >= 1 && Ahead <= 3, [MA Base])
			```
		lineageTag: dba3523c-5805-499f-9dac-5d87c033cc26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Linear' = ```
			
			    VAR N = [Forecast Fit Months]
			    VAR LastM = DATE(YEAR([Data End Date]), MONTH([Data End Date]), 1)
			    VAR Ahead = DATEDIFF(LastM, MAX(dim_date[month_start_date]), MONTH)
			    VAR T =
			        CALCULATETABLE(
			            ADDCOLUMNS(
			                FILTER(ALL(dim_date[month_start_date]),
			                    dim_date[month_start_date] > EDATE(LastM, -N) && dim_date[month_start_date] <= LastM),
			                "@x", DATEDIFF(LastM, dim_date[month_start_date], MONTH),
			                "@y", [Order Amount]),
			            REMOVEFILTERS(dim_date))
			    VAR cnt = COUNTROWS(T)
			    VAR sx  = SUMX(T, [@x])
			    VAR sy  = SUMX(T, [@y])
			    VAR sxy = SUMX(T, [@x] * [@y])
			    VAR sxx = SUMX(T, [@x] * [@x])
			    VAR slope = DIVIDE(cnt * sxy - sx * sy, cnt * sxx - sx * sx)
			    VAR intercept = DIVIDE(sy - slope * sx, cnt)
			    RETURN IF(Ahead >= 1 && Ahead <= 3, MAX(0, intercept + slope * Ahead))
			```
		lineageTag: e92f20fb-4ce5-4c42-a611-cdcb630b5b6c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Next 3 Months Total (MA)' = ```
			
			    [MA Base] * 3
			```
		lineageTag: 6062a031-5777-4da8-ad5c-bc9cd8fc56ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Forecast Window Flag' = ```
			
			    VAR LastM = DATE(YEAR([Data End Date]), MONTH([Data End Date]), 1)
			    VAR m = MAX(dim_date[month_start_date])
			    RETURN IF(m > EDATE(LastM, -[Forecast Fit Months]) && m <= EDATE(LastM, 3), 1, 0)
			```
		formatString: 0
		lineageTag: 8a628762-82d5-4603-840c-37443c8ffe5b

