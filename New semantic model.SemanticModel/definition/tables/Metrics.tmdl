	measure 'Order Amount PY LFL' = ```
			
			    VAR DE = [Data End Date]
			    VAR S = DATE(YEAR(DE) - 1, 1, 1)
			    VAR E = EDATE(DE, -12)
			    RETURN CALCULATE([Order Amount], REMOVEFILTERS(dim_date), dim_date[date] >= S, dim_date[date] <= E)
			```
		lineageTag: 609ad7e0-2caf-48a4-9da9-4149ce3b0d97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Order Quantity PY LFL' = ```
			
			    VAR DE = [Data End Date]
			    VAR S = DATE(YEAR(DE) - 1, 1, 1)
			    VAR E = EDATE(DE, -12)
			    RETURN CALCULATE([Order Quantity], REMOVEFILTERS(dim_date), dim_date[date] >= S, dim_date[date] <= E)
			```
		lineageTag: 2dfe4b2a-9875-465e-a5a0-e839b930e387

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Sales % LFL' = ```
			
