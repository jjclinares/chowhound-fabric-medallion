	measure 'Peer Avg Amount (Area)' = ```
			
			    VAR a = SELECTEDVALUE(dim_restaurant[restaurant_area_name])
			    RETURN CALCULATE(
			        AVERAGEX(VALUES(dim_restaurant[restaurant_location_id]), [Order Amount]),
			        REMOVEFILTERS(dim_restaurant),
			        dim_restaurant[restaurant_area_name] = a)
			```
		lineageTag: 5a4fd73b-8146-4900-8d8f-d48cb07a00c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'vs Peer Avg %' = ```
			
			    DIVIDE([Order Amount] - [Peer Avg Amount (Area)], [Peer Avg Amount (Area)])
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d4f59f12-7de0-4af7-94e6-c7a20d21776c

	measure 'Rank in Area' = ```
			
			    VAR a = SELECTEDVALUE(dim_restaurant[restaurant_area_name])
			    RETURN IF(NOT ISBLANK(a) && NOT ISBLANK([Order Amount]),
			        RANKX(
			            CALCULATETABLE(VALUES(dim_restaurant[restaurant_location_id]),
			                REMOVEFILTERS(dim_restaurant),
			                dim_restaurant[restaurant_area_name] = a),
			            [Order Amount], , DESC, DENSE))
			```
		formatString: 0
		lineageTag: d41dfe4a-2826-491a-8f58-5b67960d16a0

	measure 'Restaurants Above Peer Avg' = ```
			
			    SUMX(VALUES(dim_restaurant[restaurant_location_id]), IF([Order Amount] > [Peer Avg Amount (Area)], 1, 0))
			```
		formatString: 0
		lineageTag: d20383e5-2fb8-4a1c-ac5c-d4481b3692d8

	measure 'Restaurants Below Peer Avg' = ```
			
			    SUMX(VALUES(dim_restaurant[restaurant_location_id]), IF(NOT ISBLANK([Order Amount]) && [Order Amount] <= [Peer Avg Amount (Area)], 1, 0))
			```
		formatString: 0
		lineageTag: d86ffc35-5ffa-4b94-8f68-489299fb9b33

	measure 'Share Above Peer Avg' = ```
			
			    DIVIDE([Restaurants Above Peer Avg], [Restaurants Above Peer Avg] + [Restaurants Below Peer Avg])
			```
