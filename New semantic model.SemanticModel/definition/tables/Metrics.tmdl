		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Unmet Lines (Eligible)' = ```
			
			    VAR Cutoff = [Data End Date] - [Reorder Window Days]
			    RETURN CALCULATE([Order Lines],
			        fact_order_lines[fulfillment_status] = "Not Fulfilled",
			        fact_order_lines[entry_date] <= Cutoff)
			```
		formatString: 0
		lineageTag: 63a70791-3664-449f-b5fa-d04373e5cc88

	measure 'Unmet Amount (Eligible)' = ```
			
			    VAR Cutoff = [Data End Date] - [Reorder Window Days]
			    RETURN CALCULATE([Amount Lost],
			        fact_order_lines[fulfillment_status] = "Not Fulfilled",
			        fact_order_lines[entry_date] <= Cutoff)
			```
		lineageTag: 41ebaaba-67aa-49dc-b4a5-4a1a25f6102c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reordered Any Lines' = ```
			
			    VAR W = [Reorder Window Days]
			    VAR Cutoff = [Data End Date] - W
			    RETURN
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                fact_order_lines,
			                fact_order_lines[fulfillment_status] = "Not Fulfilled",
			                fact_order_lines[entry_date] <= Cutoff),
			            VAR r = fact_order_lines[sk_restaurant]
			                VAR p = fact_order_lines[sk_product]
			                VAR d = fact_order_lines[entry_date]
			                VAR q = fact_order_lines[order_quantity]
			                RETURN
			                    COUNTROWS(
			                        CALCULATETABLE(
			                            fact_order_lines,
			                            REMOVEFILTERS(),
			                            fact_order_lines[sk_restaurant] = r,
			                            fact_order_lines[sk_product] = p,
			                            fact_order_lines[entry_date] > d,
			                            fact_order_lines[entry_date] <= d + W)) > 0))
			```
		formatString: 0
		lineageTag: 28ec9f38-ae75-41fa-b70e-8074d6aca8f4

	measure 'Reordered Same or Higher Lines' = ```
			
			    VAR W = [Reorder Window Days]
			    VAR Cutoff = [Data End Date] - W
			    RETURN
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                fact_order_lines,
			                fact_order_lines[fulfillment_status] = "Not Fulfilled",
			                fact_order_lines[entry_date] <= Cutoff),
			            VAR r = fact_order_lines[sk_restaurant]
			                VAR p = fact_order_lines[sk_product]
			                VAR d = fact_order_lines[entry_date]
			                VAR q = fact_order_lines[order_quantity]
			                RETURN
			                    COUNTROWS(
			                        CALCULATETABLE(
			                            fact_order_lines,
			                            REMOVEFILTERS(),
			                            fact_order_lines[sk_restaurant] = r,
			                            fact_order_lines[sk_product] = p,
			                            fact_order_lines[entry_date] > d,
			                            fact_order_lines[entry_date] <= d + W,
			                            fact_order_lines[order_quantity] >= q)) > 0))
			```
		formatString: 0
		lineageTag: 3be12b3d-2ec7-4be8-8df6-1274e97cb939

	measure 'Reordered Higher Lines' = ```
			
			    VAR W = [Reorder Window Days]
			    VAR Cutoff = [Data End Date] - W
			    RETURN
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                fact_order_lines,
			                fact_order_lines[fulfillment_status] = "Not Fulfilled",
			                fact_order_lines[entry_date] <= Cutoff),
			            VAR r = fact_order_lines[sk_restaurant]
			                VAR p = fact_order_lines[sk_product]
			                VAR d = fact_order_lines[entry_date]
			                VAR q = fact_order_lines[order_quantity]
			                RETURN
			                    COUNTROWS(
			                        CALCULATETABLE(
			                            fact_order_lines,
			                            REMOVEFILTERS(),
			                            fact_order_lines[sk_restaurant] = r,
			                            fact_order_lines[sk_product] = p,
			                            fact_order_lines[entry_date] > d,
			                            fact_order_lines[entry_date] <= d + W,
			                            fact_order_lines[order_quantity] > q)) > 0))
			```
		formatString: 0
		lineageTag: 198ab81b-2bf3-470b-a38c-b012a02a1eed

	measure 'Reordered Equal Lines' = ```
			
			    [Reordered Same or Higher Lines] - [Reordered Higher Lines]
